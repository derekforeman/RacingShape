# Copy this to api/.env (gitignored) — the API auto-loads it via dotenv on startup.
# GITHUB_TOKEN is the only required var; the rest have sane defaults.

# GitHub PAT or App token with read access to the tracked repo (S2AI/s2shape is private).
# Server-side only — never sent to the browser.
GITHUB_TOKEN=

# Repository to track (defaults shown)
REPO_OWNER=S2AI
REPO_NAME=s2shape

# API listen port (default 8787)
PORT=8787

# Poll cadence in ms (default 60000)
POLL_INTERVAL_MS=60000

# Snapshot/replay frame cadence in ms (default 300000 = 5 min)
SNAPSHOT_INTERVAL_MS=300000

# SQLite file path (default ./data/racingshape.db, relative to the api workspace)
DB_PATH=./data/racingshape.db

# Optional site-wide password (HTTP Basic Auth). Set it to lock the whole app behind a
# shared password (any username works); leave it blank/unset for no auth (local dev).
# In production set it as a secret, not here:  fly secrets set SITE_PASSWORD=...
SITE_PASSWORD=
